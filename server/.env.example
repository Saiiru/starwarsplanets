# HOLO-NET Fleet API — ambiente local
# Copie este arquivo para server/.env, restrinja permissões e preencha os campos vazios.
# Não há usuário/senha padrão. O primeiro início falha se não configurar a conta.
HOST=127.0.0.1
PORT=4358
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Opcional: roteamento por modelo OpenAI-compatible SOMENTE na própria máquina.
# Não configure serviço remoto nem chaves de terceiros nesta etapa.
HOLONET_LLM_MODEL=
HOLONET_LLM_BASE_URL=http://127.0.0.1:8080/v1/chat/completions
